# ===== ModelScope =====
# 在 https://www.modelscope.cn 控制台「访问令牌」获取。注意保密，绝不能进前端代码。
MODELSCOPE_API_KEY=ms-xxxxxx

# ===== 腾讯云 COS（把源图转成公网 URL，FireRed 模型只接受 image_url）=====
# 密钥在腾讯云控制台「访问管理 → API密钥管理」获取；也可读你本地的 SecretKey.csv
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
# 你已有的桶（公开读对象即可，无需 cos-website 站点）
COS_BUCKET=pet-camera-1322296918
COS_REGION=ap-guangzhou

# ===== 服务 =====
PORT=3000
# 可选：覆盖默认模型
FIRERED_MODEL=FireRedTeam/FireRed-Image-Edit-1.1
