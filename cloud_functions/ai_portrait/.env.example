# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
# 服务器部署：cp .env.example .env 后逐一替换占位符

# 百炼/千问 API Key（必填）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 写真模型（可选）：默认 wan2.7-image-pro（multimodal-generation，base64 内联图，无需 COS 图床）
MODEL=wan2.7-image-pro

# ============ AI 一键成片（图生视频）模型配置 ============
# 默认 wanx2.1-i2v-plus（万相-图生视频-基于首帧；当前百炼额度可用，仅 720P / 固定 5s）。
# 可选（见 lib/videoAdapter.js 注册表）：
#   wan2.6-i2v / wan2.6-i2v-flash / wan2.6-i2v-us / wan2.5-i2v-preview
#   wan2.2-i2v-flash / wan2.2-i2v-plus / wanx2.1-i2v-turbo / wanx2.1-i2v-plus
#   wan2.7-i2v（旧 input.media 格式，需显式指定才用）
VIDEO_MODEL=wanx2.1-i2v-plus

# 分辨率档位（可选）：默认 720P。wanx2.1-i2v-plus 仅支持 720P；
# wan2.6 系列支持 720P/1080P；wan2.5-i2v-preview 另支持 480P；详见适配器规格表。
I2V_RESOLUTION=720P

# prompt 智能改写（可选，默认 false）：前端已走 LLM 扩写 prompt，一般无需再开。
# 设 true 后由模型侧对输入 prompt 二次扩写，可能增加耗时。
I2V_PROMPT_EXTEND=false

# 仅 wan2.6-i2v-flash 支持显式控制有声/无声（可选）：true 有声 / false 无声，不设走模型默认。
I2V_AUDIO=

# 固定随机种子（可选）：0~2147483647，未设时系统随机，想复现结果可固定。
I2V_SEED=

# 腾讯云 COS（必填）：既作千问旧版输入图临时图床，也用于「我的创作」云存储上传：
#   前端 POST /api/upload { dataBase64, type, ext, label, petId } -> 存 works/ 目录，
#   追加 works.json 清单并返回公网 URL。种子数据在 COS 的 seed.json（已由迁移脚本上传）。
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_COS_BUCKET=pet-camera-1322296918
TENCENT_COS_REGION=ap-guangzhou

# 监听端口：按部署环境反向代理配置填。本服务默认 3001（3000 被其他服务占用）。
PORT=3001

# 跨域来源：开发期可用 *；正式上线建议改成你的站点域名（如 https://yangyuting.cloud）
ALLOW_ORIGIN=*

# ============ 宠物物种识别（可选，默认关闭） ============
# 作用：打开相机自动识别"是猫还是狗"，减少用户手选。
# 未配置时接口如实返回 available:false，App 静默降级为用户手选，不会报错。
#
# SPECIES_PROVIDER 取值：
#   off    默认，不启用
#   mock   演示模式：不连外网，固定返回 SPECIES_MOCK_RESULT 指定的物种
#   baidu  百度 AI 开放平台「动物识别」（有免费额度，按量计费）
SPECIES_PROVIDER=off

# baidu 模式下必填：百度 AI 开放平台应用信息
# 控制台：https://console.bce.baidu.com/ai/  ->  图像识别  ->  创建应用
BAIDU_AI_API_KEY=
BAIDU_AI_SECRET_KEY=

# 置信度下限（可选，默认 0.5）：低于此值视为"没识别出来"，
# 前端会退回"沿用当前物种 + 提示用户确认"，而不是硬套一个错的参数。
SPECIES_CONFIDENCE_MIN=0.5

# mock 模式下固定返回的物种（可选，默认 cat）：cat | dog | rabbit | chinchilla
SPECIES_MOCK_RESULT=cat
