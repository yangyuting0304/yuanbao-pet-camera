# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-synthesis

# 腾讯云 COS（用作千问输入图的临时公网图床）
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
TENCENT_COS_BUCKET=your-bucket
TENCENT_COS_REGION=ap-guangzhou

PORT=3001
# 开发期先用 * 放开跨域；正式上线建议改成你的站点域名（如 http://120.24.240.129）
ALLOW_ORIGIN=*
