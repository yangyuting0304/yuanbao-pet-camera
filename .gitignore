# 归档产物（网页版快照，单独存 release/，不进源码库）
/release/

# 根目录误装的 Node 依赖（COS SDK 遗留物，真正工具在 tools/* 下各自 node_modules）
/node_modules/
/node_modules/**

# tools/* 下各 Node 工具（font-subset、seed-upload）的依赖，按需 npm i 重建，不入库
/tools/*/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 开发遗留备份（含大体积 MPO 原图，不进源码库）
/_dev_backup/

